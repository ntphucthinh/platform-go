# Copy to .env.local and replace placeholders for local development.
APP_ENV=local
PORT=8080
DB_HOST=platform-db
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=platform_db
# Required: use a unique random value with at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
CORS_ALLOW_ORIGIN=http://localhost:3000
# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave empty when serving directly.
TRUSTED_PROXIES=

# For 'local' mode only, choose whether to output to a file or the console [file, print]
LOG_TYPE=file
LOG_FILE_PATH=logs/gin.log

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Required Cloudinary folder namespace. Supported values: dev, stg.
# The logical path stored in the database remains, for example, homestays/<uuid>.png.
CLOUDINARY_ASSET_ENV=dev
