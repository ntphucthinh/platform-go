# Copy to .env.staging or env.staging for staging server deployment.
APP_ENV=staging
PORT=8080

# Database Configuration for Go Application
DB_HOST=platform-db
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=platform_db

# MySQL Container Settings (used by platform-db)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=platform_db
MYSQL_USER=platform_user
MYSQL_PASSWORD=staging_password

# Required: use a unique random value with at least 32 characters
JWT_SECRET=replace-with-a-secure-staging-jwt-secret-min-32-chars

# CORS: Set to your frontend staging URL
CORS_ALLOW_ORIGIN=https://staging.yourdomain.com
